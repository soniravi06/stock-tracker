// Stock Portfolio Tracker - Schema v0.2 (Position Model)
//
// Model:
//   - Transaction row = a BUY lot. `remainingQty` tracks how many shares from
//     this lot are still open. When sold, lot remainingQty decrements.
//   - CompletedTrade row = a SELL event that consumed one or more buy lots.
//     Stores weighted-avg buy price, sell price, commission, P&L.
//     Stores JSON snapshot of which lots were matched for display + audit.
//   - No LTCG/STCG logic in this phase.
//
// Defaults to postgres for production. For local SQLite dev, change
// provider to "sqlite" and DATABASE_URL to "file:./dev.db" in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  superadmin
  admin
  client
}

enum Exchange {
  NSE
  BSE
}

enum CommissionType {
  percentage
  flat
}

enum PaymentDirection {
  in
  out
}

enum PaymentStatus {
  pending
  received
}

enum AlertMode {
  price
  percent
}

enum AlertDirection {
  above
  below
}

enum AlertStatus {
  active
  triggered
  dismissed
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  role           Role
  name           String?
  phone          String?
  linkedClientId String?   @unique
  linkedClient   Client?   @relation("ClientLogin", fields: [linkedClientId], references: [id])
  clientsOwned   Client[]  @relation("AdminClients")
  auditLogs      AuditLog[] @relation("Actor")
  feedback       Feedback[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Client {
  id                      String           @id @default(cuid())
  adminId                 String
  admin                   User             @relation("AdminClients", fields: [adminId], references: [id])
  name                    String
  email                   String?
  phone                   String?
  defaultCommissionType   CommissionType   @default(percentage)
  defaultCommissionValue  Float            @default(0.5)
  loginUser               User?            @relation("ClientLogin")
  transactions            Transaction[]
  completedTrades         CompletedTrade[]
  payments                Payment[]
  priceAlerts             PriceAlert[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?

  @@index([adminId])
}

// A BUY lot. Sells are no longer transactions — they become CompletedTrade rows.
model Transaction {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id])
  symbol            String
  exchange          Exchange  @default(NSE)
  quantity          Float     // Original buy quantity
  remainingQty      Float     // Decreases as shares are sold via CompletedTrade
  pricePerShare     Float
  tradeDate         DateTime
  notes             String?
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  priceAlerts       PriceAlert[]

  @@index([clientId])
  @@index([symbol])
  @@index([tradeDate])
  @@index([deletedAt])
  @@index([clientId, deletedAt])
  @@index([clientId, symbol, deletedAt])
}

// A completed sell event. May have consumed multiple buy lots (FIFO).
// The matchedLotsJson field stores:
//   [{ buyTransactionId, buyDate, buyPrice, qty }]
// so we can render the expandable breakdown and audit the match.
model CompletedTrade {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id])
  symbol            String
  exchange          Exchange  @default(NSE)
  sellDate          DateTime
  sellQty           Float
  sellPricePerShare Float
  // Weighted average buy price across all matched lots (commission-free)
  avgBuyPrice       Float
  totalBuyCost      Float     // sum of (lotQty * lotPrice) across matched lots
  totalSellProceeds Float     // sellQty * sellPricePerShare
  grossPnL          Float     // totalSellProceeds - totalBuyCost
  commissionType    CommissionType
  commissionValue   Float     // the % or flat value as entered
  commissionAmount  Float     // the computed absolute commission in INR
  netPnL            Float     // grossPnL - commissionAmount
  matchedLotsJson   String    // JSON array of matched lot breakdowns
  notes             String?
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([clientId])
  @@index([symbol])
  @@index([sellDate])
  @@index([deletedAt])
  @@index([clientId, deletedAt])
}

model Payment {
  id              String           @id @default(cuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  amount          Float
  direction       PaymentDirection
  status          PaymentStatus    @default(pending)
  date            DateTime
  notes           String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([clientId])
  @@index([status])
  @@index([clientId, deletedAt])
}

// A price alert rule attached to a single BUY lot.
model PriceAlert {
  id             String         @id @default(cuid())
  transactionId  String
  transaction    Transaction    @relation(fields: [transactionId], references: [id])
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  mode           AlertMode
  direction      AlertDirection
  targetPrice    Float?         // used when mode = price
  targetPercent  Float?         // used when mode = percent (signed, e.g. 10 or -5)
  status         AlertStatus    @default(active)
  triggeredAt    DateTime?
  triggeredPrice Float?
  createdByUserId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  events         AlertEvent[]

  @@index([clientId])
  @@index([transactionId])
  @@index([status])
}

// Immutable history of every alert trigger.
model AlertEvent {
  id             String     @id @default(cuid())
  alertId        String
  alert          PriceAlert @relation(fields: [alertId], references: [id])
  transactionId  String
  clientId       String
  symbol         String
  priceAtTrigger Float
  message        String
  triggeredAt    DateTime   @default(now())

  @@index([clientId])
  @@index([alertId])
  @@index([triggeredAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role
  page      String
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  symbol     String
  exchange   Exchange
  price      Float
  fetchedAt  DateTime @default(now())

  @@unique([symbol, exchange])
  @@index([fetchedAt])
}

model AuditLog {
  id                String   @id @default(cuid())
  actorUserId       String
  actor             User     @relation("Actor", fields: [actorUserId], references: [id])
  actorRole         Role
  onBehalfOfAdminId String?
  action            String
  entityType        String   // "Client" | "Transaction" | "CompletedTrade" | "Payment" | "User"
  entityId          String
  beforeJson        String?
  afterJson         String?
  summary           String?
  ipAddress         String?
  createdAt         DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
